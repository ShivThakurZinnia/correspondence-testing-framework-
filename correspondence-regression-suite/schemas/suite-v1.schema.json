{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "environmentRef", "scenarioRefs", "requiredClients", "requiredCapabilities"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "id": {"type": "string", "minLength": 1},
    "environmentRef": {"type": "string", "minLength": 1},
    "scenarioRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiredClients": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requiredCapabilities": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "version", "evidenceMode"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "evidenceMode": {"enum": ["REAL", "SIMULATED"]}
        }
      }
    }
  }
}
