# Which NGC environment the Mongo/Kafka/S3 settings below belong to. Runs for any other environment are refused.
NGC_ENVIRONMENT=dev

# Read-only access to that environment's NGC MongoDB (the tool never writes here).
# Atlas format; percent-encode special characters in the password (@ = %40, # = %23, / = %2F, : = %3A).
# The URI has no database name, so MONGODB_DATABASE is required as well.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority&appName=<app-name>
MONGODB_DATABASE=

# Kafka used by the injector. Local Kafka needs only the address; for Confluent Cloud also set the two below.
KAFKA_BOOTSTRAP_SERVER=localhost:9092
# KAFKA_KEY=
# KAFKA_SECRET=

# S3 bucket holding generated NGC XML (read-only). Credentials: AWS default chain, e.g. AWS_PROFILE + `aws sso login`
AWS_REGION=us-east-1
S3_BUCKET_NAME=
# AWS_PROFILE=

# Local app store (H2 file mode)
H2_FILE_PATH=./data/ngc-regression

# Fixed login for the UI, CLI and API (HTTP Basic). The password is required.
REGRESSION_USER=admin
REGRESSION_PASSWORD=
