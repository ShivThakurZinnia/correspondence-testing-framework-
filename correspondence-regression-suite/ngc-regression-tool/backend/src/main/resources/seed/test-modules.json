[
  {
    "code": "policy-page",
    "name": "Policy Page",
    "description": "Policy page (POLPG) letters sent after a policy is activated or issued. NGC mapper: PolicyPageXmlMapper.",
    "cases": [
      {
        "key": "gili-policy-page-owner-print",
        "name": "GILI policy page - owner, print",
        "description": "Policy activation sends the policy page to the owner as print, with the servicing agent copied. Seen in Dev for GCFIA901, GCFIA902 and GCFIA903. PLACEHOLDER payload: replace the REPLACE_ME values (policy number, party and policy reference ids) with a real Dev test policy before running; everything else mirrors what NGC receives in Dev.",
        "kafkaKind": "SOR",
        "topic": "zinnia.correspondence.sor",
        "eventType": "policy.activation.completed",
        "carrier": "GILI",
        "planCodes": [
          "GCFIA901",
          "GCFIA902",
          "GCFIA903"
        ],
        "payload": "policy-page-activation.json",
        "timeout": 600,
        "tags": [
          "client:GILI",
          "mapper:policy-page"
        ],
        "expected": {
          "incomingEvent": {
            "status": "SENT_TO_CDS"
          },
          "targets": [
            {
              "role": "OWNER",
              "status": "SENT_TO_CDS",
              "deliveryType": "PRINT",
              "agentType": "PRIMARYSERVICINGAGENT",
              "documentType": "POLPG",
              "xmlFileName": "present"
            }
          ],
          "cds": {
            "published": true
          },
          "journey": [
            "requestValid",
            "requestStart",
            "requestSentToCDS"
          ],
          "noFailures": [
            "technical_failures",
            "dead_letter_events"
          ]
        }
      }
    ]
  },
