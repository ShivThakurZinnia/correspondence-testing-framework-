{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "services", "clients", "expectations", "scenarios", "environments", "suites"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "catalogVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "services": {"$ref": "#/$defs/paths"},
    "clients": {"$ref": "#/$defs/paths"},
    "expectations": {"$ref": "#/$defs/paths"},
    "scenarios": {"$ref": "#/$defs/paths"},
    "environments": {"$ref": "#/$defs/paths"},
    "suites": {"$ref": "#/$defs/paths"}
  },
  "$defs": {
    "paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-zA-Z0-9_./-]+\\.json$"}
    }
  }
}
