{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "description", "allowedServices"],
  "properties": {
    "schemaVersion": {"const": "1.0"}, "id": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "allowedServices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
